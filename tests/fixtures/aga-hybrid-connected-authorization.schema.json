{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviasurveil360.local/schemas/aga-hybrid-connected-authorization/v1",
  "title": "AGA hybrid connected authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorizationId",
    "issuer",
    "nonce",
    "issuedAt",
    "expiresAt",
    "inputDigest",
    "codeDigest",
    "contractDigest",
    "phase",
    "targetMode",
    "operations",
    "tokens",
    "operationTokenHashes"
  ],
  "properties": {
    "schemaVersion": { "const": "aga-hybrid-demo-connected-authorization/v1" },
    "authorizationId": { "type": "string", "pattern": "^aga-auth-[a-f0-9]{32}$" },
    "issuer": { "type": "string", "minLength": 1, "maxLength": 128 },
    "nonce": { "type": "string", "pattern": "^[a-f0-9]{32,}$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "codeDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "contractDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "phase": {
      "type": "string",
      "enum": ["prepare", "qualification", "recovery", "cleanup", "fault-matrix-prepare", "fault-matrix-run", "fault-matrix-recovery"]
    },
    "targetMode": {
      "type": "string",
      "enum": ["CREATE_FRESH_DISPOSABLE", "EXACT_TARGET"]
    },
    "targetFingerprintDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "intentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "journalDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "bundleDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "outerIntentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "caseTargetFingerprints": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "operationTokenHashes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "targetMode": { "const": "EXACT_TARGET" } } },
      "then": { "required": ["targetFingerprintDigest", "intentDigest"] }
    },
    {
      "if": { "properties": { "targetMode": { "const": "CREATE_FRESH_DISPOSABLE" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["targetFingerprintDigest"] },
            { "required": ["intentDigest"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "phase": { "enum": ["qualification", "recovery", "cleanup", "fault-matrix-run", "fault-matrix-recovery"] } } },
      "then": { "required": ["targetFingerprintDigest", "intentDigest"] }
    }
  ]
}
