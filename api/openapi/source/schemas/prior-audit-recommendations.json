{
  "CanonicalQuestionRecommendation": {
    "type": "object",
    "additionalProperties": false,
    "required": ["recommendationState", "classification", "includedByDefault", "canDefer", "historyCount", "comparableAuditCount", "validatedCleanAuditCount", "lastComparableResult", "lastComparableAuditId", "lastValidatedCleanAt", "signalCodes", "rationale", "guardrails"],
    "properties": {
      "recommendationState": { "type": "string", "enum": ["SUGGESTED_NOW", "MATCHING_OPTIONAL", "RECENTLY_VERIFIED", "OUTSIDE_FOCUS", "UNCERTAIN_SIGNAL"] },
      "classification": { "type": "string", "enum": ["MANDATORY_CORE", "FOCUSED_FULL", "ROTATIONAL_SAMPLE", "DEFER_ELIGIBLE"] },
      "includedByDefault": { "type": "boolean" },
      "canDefer": { "type": "boolean" },
      "historyCount": { "type": "integer", "minimum": 0 },
      "comparableAuditCount": { "type": "integer", "minimum": 0 },
      "validatedCleanAuditCount": { "type": "integer", "minimum": 0 },
      "lastComparableResult": { "type": ["string", "null"] },
      "lastComparableAuditId": { "type": ["string", "null"] },
      "lastValidatedCleanAt": { "type": ["string", "null"], "format": "date-time" },
      "lastVerifiedAt": { "type": ["string", "null"], "format": "date-time" },
      "recurrenceDueAt": { "type": ["string", "null"], "format": "date-time" },
      "signalCodes": { "type": "array", "items": { "type": "string" } },
      "rationale": { "type": "string" },
      "guardrails": { "type": "array", "items": { "type": "string" } }
    }
  }
  ,"CanonicalQuestionRecommendationSummary": {
    "type": "object",
    "additionalProperties": false,
    "required": ["organizationLabel", "providerScopeLabel", "regulatedTargetLabel", "locationLabel", "generalInspectionTypeLabel", "auditTypeLabel", "evaluationAsOf", "historyWindowMonths", "historyWindowStart", "historyWindowEnd", "comparableAuditCount", "historyDeferredCount", "focusConfigured", "focusType", "focusInspectionTypeCodes", "recommendationEvaluationDigest"],
    "properties": {
      "organizationLabel": { "type": "string" },
      "providerScopeLabel": { "type": "string" },
      "regulatedTargetLabel": { "type": "string" },
      "locationLabel": { "type": "string" },
      "generalInspectionTypeLabel": { "type": "string" },
      "auditTypeLabel": { "type": "string" },
      "evaluationAsOf": { "type": "string", "format": "date-time" },
      "historyWindowMonths": { "type": "integer", "minimum": 1, "maximum": 120 },
      "historyWindowStart": { "type": "string", "format": "date-time" },
      "historyWindowEnd": { "type": "string", "format": "date-time" },
      "comparableAuditCount": { "type": "integer", "minimum": 0 },
      "historyDeferredCount": { "type": "integer", "minimum": 0 },
      "focusConfigured": { "type": "boolean" },
      "focusType": { "type": ["string", "null"] },
      "focusInspectionTypeCodes": { "type": "array", "items": { "type": "string" } },
      "recommendationEvaluationDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    }
  }
}
