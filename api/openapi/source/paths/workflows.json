    "post": { "operationId": "resolvePlanningLocation", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["operationId", "idempotencyKey", "organizationId", "regulatedTargetId", "proposedLabel"], "properties": { "operationId": { "type": "string" }, "idempotencyKey": { "type": "string" }, "organizationId": { "type": "string" }, "regulatedTargetId": { "type": "string" }, "proposedLabel": { "type": "string" } } } } } }, "responses": { "200": { "description": "Resolved Planning location", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanningLocationResolution" } } } } } }
