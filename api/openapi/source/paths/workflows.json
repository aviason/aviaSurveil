  },
  "/v1/planning/proposal-drafts/{draftId}": {
    "get": { "operationId": "getPlanningProposalDraft", "parameters": [{ "name": "draftId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Planning proposal draft", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanningProposalDraftView" } } } } } },
    "put": { "operationId": "savePlanningProposalDraft", "parameters": [{ "name": "draftId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SavePlanningProposalDraftInput" } } } }, "responses": { "200": { "description": "Saved Planning proposal draft", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanningProposalDraftView" } } } } } }
