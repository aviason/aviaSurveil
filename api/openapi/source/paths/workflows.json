    "post": { "operationId": "assignAuditTeam", "parameters": [{ "name": "assignmentId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssignTeamInput" } } } }, "responses": { "200": { "description": "Assigned inspection team", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CanonicalAssignmentView" } } } }, "default": { "$ref": "#/components/responses/Problem" } } }
