  "/v1/audit-assignments/{assignmentId}/question-coverage": {
    "post": { "operationId": "assignAuditQuestionCoverage", "parameters": [{ "name": "assignmentId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssignQuestionsInput" } } } }, "responses": { "200": { "description": "Assigned exact per-question coverage", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CanonicalAssignmentView" } } } }, "default": { "$ref": "#/components/responses/Problem" } } }
