    "post": {
      "operationId": "finalizePlanningAuditPackage",
      "parameters": [{ "name": "planningItemId", "in": "path", "required": true, "schema": { "type": "string" } }],
      "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FinalizePlanningAuditPackageInput" } } } },
      "responses": {
        "200": { "description": "Finalized immutable Audit-package scope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanningAuditPackageSetupView" } } } },
        "default": { "$ref": "#/components/responses/Problem" }
      }
    }
  },
  "/v1/planning/intake-drafts/{draftId}": {
    "get": { "operationId": "getPlanningIntakeDraft", "parameters": [{ "name": "draftId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Planning intake draft", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanningIntakeDraftView" } } } } } },
    "put": { "operationId": "savePlanningIntakeDraft", "parameters": [{ "name": "draftId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SavePlanningIntakeDraftInput" } } } }, "responses": { "200": { "description": "Saved planning intake draft", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanningIntakeDraftView" } } } } } }
