    "post": { "operationId": "previewAuditQuestionCoverage", "parameters": [{ "name": "assignmentId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PreviewAssignQuestionsInput" } } } }, "responses": { "201": { "description": "Created bounded server-issued question coverage preview", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PreparationEditPreviewView" } } } }, "default": { "$ref": "#/components/responses/Problem" } } }
