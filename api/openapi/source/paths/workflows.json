    "post": { "operationId": "assignAuditLead", "parameters": [{ "name": "assignmentId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssignLeadInput" } } } }, "responses": { "200": { "description": "Assigned Lead Inspector", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CanonicalAssignmentView" } } } }, "default": { "$ref": "#/components/responses/Problem" } } }
