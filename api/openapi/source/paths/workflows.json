    "post": { "operationId": "submitPlanningProposal", "parameters": [{ "name": "draftId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmitPlanningIntakeInput" } } } }, "responses": { "200": { "description": "Submitted Planning proposal", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmitPlanningProposalOutput" } } } } } }
