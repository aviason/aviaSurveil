    "post": { "operationId": "getPlanningWorkloadEstimate", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["operationId", "idempotencyKey", "organizationId", "providerScopeId", "regulatedTargetId", "inspectionType"], "properties": { "operationId": { "type": "string" }, "idempotencyKey": { "type": "string" }, "organizationId": { "type": "string" }, "providerScopeId": { "type": "string" }, "regulatedTargetId": { "type": "string" }, "inspectionType": { "type": "string" } } } } } }, "responses": { "200": { "description": "Server-owned Planning workload estimate", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanningWorkloadEstimate" } } } } } }
