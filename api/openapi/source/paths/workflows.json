  "/v1/report-versions": {
    "post": { "operationId": "createReportVersion", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateReportVersionInput" } } } }, "responses": { "201": { "description": "Created immutable report version", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReportVersionView" } } } }, "default": { "$ref": "#/components/responses/Problem" } } }
