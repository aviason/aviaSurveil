      "conditional_field_rules": ["effective_to is nullable only for an active scope", "provider scope fields are required only for provider_scope.versioned and provider_scope.ended"],
      "forbidden_fields": ["organization_contact_data", "person_data", "arbitrary_target_text", "ambiguous_plus_or_slash_combined_codes", "credential", "unrestricted_note"],
      "entity_ref": "tenant_id + organization_id; provider_scope_id is the effective-dated child",
      "grain": "one immutable organization revision or effective-dated provider-scope revision/end",
      "additional_properties": false
    },
    "assignment_package": {
