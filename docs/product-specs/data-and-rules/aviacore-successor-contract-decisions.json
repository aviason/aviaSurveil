      "conditional_field_rules": ["reference fields are required only for regulatory_reference.versioned", "publication fields are required only for checklist_configuration.published"],
      "forbidden_fields": ["source_document_bytes", "unrestricted_source_text", "publisher_person_identity", "private_review_deliberation", "arbitrary_metadata", "credential"],
      "entity_ref": "tenant_id + configuration_id/reference_id; revision is immutable",
