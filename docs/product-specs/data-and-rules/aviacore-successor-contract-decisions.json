      "required_fields": ["audit_id", "assignment_id", "assignment_revision", "assignment_status_code", "assigned_department_code", "role_code", "package_id", "package_revision", "checklist_version_id", "checklist_digest", "applicability_digest", "ordered_question_snapshot", "question_count", "composed_at"],
