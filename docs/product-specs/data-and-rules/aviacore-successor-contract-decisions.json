      "conditional_field_rules": ["candidate fields and ordered_question_snapshot are required only for checklist_generation.candidate_versioned", "impact fields are required only for checklist_generation.impact_review_recorded", "rollout decision fields are required only for checklist_generation.rollout_readiness_recorded"],
