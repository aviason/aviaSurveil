      "forbidden_fields": ["recipient_identity", "recipient_contact_value", "reminder_body", "calendar_body", "free_text_reason", "person_identity", "secret", "token"],
      "entity_ref": "tenant_id + owning_organization_id + plan_id; reminder_id is a child fact",
