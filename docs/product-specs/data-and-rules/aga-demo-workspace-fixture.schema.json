{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviasurveil360.local/schemas/aga-demo-workspace-fixture.v1.json",
  "title": "AGA Demo Workspace Authority Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templateId", "caaOrganizationId", "departmentId", "organizationalUnitId", "syntheticNamespace", "roleSlots", "organizations", "providerConfiguration", "scopes", "bindingRules"],
  "properties": {
    "schemaVersion": {"const": "aga-demo-workspace-authority-fixture/v1"},
    "templateId": {"type": "string", "pattern": "^aga-demo-authority-template-v1$"},
    "caaOrganizationId": {"type": "string", "minLength": 1},
    "departmentId": {"type": "string", "minLength": 1},
    "organizationalUnitId": {"type": "string", "minLength": 1},
    "syntheticNamespace": {"const": "AGA_DEMO_ONLY"},
    "roleSlots": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/roleSlot"}},
    "organizations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/organization"}},
    "providerConfiguration": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/providerConfiguration"}},
    "scopes": {"type": "array", "const": [
      {"scopeSlot": "MATCHING_AERODROME_OPERATOR", "organizationSlot": "MATCHING", "providerTypeCode": "AERODROME_OPERATOR", "providerScopeRootId": "aga-ws-scope-root-matching", "providerScopeId": "aga-ws-scope-matching", "providerScopeVersion": 1, "targetId": "aga-ws-target-matching", "canonicalTargetKind": "FACILITY", "targetProfileCode": "RFFS_FUNCTION"},
      {"scopeSlot": "OTHER_AERODROME_OPERATOR", "organizationSlot": "OTHER", "providerTypeCode": "AERODROME_OPERATOR", "providerScopeRootId": "aga-ws-scope-root-other", "providerScopeId": "aga-ws-scope-other", "providerScopeVersion": 1, "targetId": "aga-ws-target-other", "canonicalTargetKind": "FACILITY", "targetProfileCode": "RFFS_FUNCTION"}
    ]},
    "bindingRules": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/binding"}}
  },
  "$defs": {
    "roleSlot": {
      "type": "object", "additionalProperties": false,
      "required": ["slot", "requiredRoles", "projection"],
      "properties": {"slot": {"type": "string", "minLength": 1}, "requiredRoles": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "projection": {"type": "string", "minLength": 1}}
    },
    "organization": {
      "type": "object", "additionalProperties": false,
      "required": ["organizationId", "name", "other"],
      "properties": {"organizationId": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "other": {"type": "boolean"}}
    },
    "providerConfiguration": {
      "type": "object", "additionalProperties": false,
      "required": ["providerTypeCode", "disposition", "reasonCode"],
      "properties": {"providerTypeCode": {"type": "string", "minLength": 1}, "disposition": {"enum": ["INSPECTED_SCOPE_ELIGIBLE", "INVOLVEMENT_ONLY", "NO_DEFAULT_AGA_RELATIONSHIP"]}, "reasonCode": {"type": "string", "minLength": 1}}
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["bindingId", "subjectSlot", "membershipSlot", "organizationId", "departmentId", "organizationalUnitId", "operationRoles", "active"],
      "properties": {"bindingId": {"type": "string", "minLength": 1}, "subjectSlot": {"type": "string", "minLength": 1}, "membershipSlot": {"type": "string", "minLength": 1}, "organizationId": {"type": "string", "minLength": 1}, "departmentId": {"type": "string", "minLength": 1}, "organizationalUnitId": {"type": "string", "minLength": 1}, "operationRoles": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "active": {"const": true}}
    }
  }
}
