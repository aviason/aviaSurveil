schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}

scalar AWSDateTime
scalar AWSJSON

type Query {
  me: Viewer!
  publicUser(id: ID!): PublicUser!
  home(input: HomeInput!): HomePayload!
  items(input: ItemsInput!): ItemConnection!
  myItems(input: PaginationInput): ItemConnection!
  item(id: ID!): Item!
  itemDetail(id: ID!): ItemDetailPayload!
  itemRequests(itemId: ID!, input: PaginationInput): RequestConnection!
  conversations(input: PaginationInput): ConversationConnection!
  messages(requestId: ID!, input: MessagePageInput): MessageConnection!
  messageReports(input: PaginationInput): MessageReportConnection!
  notifications(input: PaginationInput): NotificationConnection!
  points(input: PaginationInput): PointsPayload!
  stats(input: CommunityStatsInput): StatsPayload!
  subscription: SubscriptionEntitlement!
  userKeys(userId: ID!): UserKeysBundle!
  userKeyHistory(userId: ID!): UserKeysTransparencyHistory!
  keyTransparencyTreeHead: UserKeysSignedTreeHead! @aws_api_key
  keyTransparencyLog(from: Int = 0, limit: Int = 1000): UserKeysTransparencyLog! @aws_api_key
  ratchetPrekeyStatus: RatchetPrekeyStatus!
  ratchetBundle(userId: ID!): RatchetBundle!
  identityBackup: IdentityBackup
}

type Mutation {
  register(input: RegisterInput!): AuthPayload! @aws_api_key
  login(input: LoginInput!): AuthPayload! @aws_api_key
  reactivate(input: LoginInput!): AuthPayload! @aws_api_key
  refreshSession(input: RefreshSessionInput!): AuthPayload! @aws_api_key
  logout(input: LogoutInput!): Boolean!
  verifyEmail(input: VerifyEmailInput!): Boolean! @aws_api_key
  resendEmailVerification(input: EmailInput!): Boolean! @aws_api_key
  forgotPassword(input: EmailInput!): Boolean! @aws_api_key
  resetPassword(input: ResetPasswordInput!): Boolean! @aws_api_key

  createItem(input: CreateItemInput!): Item!
  updateItem(id: ID!, input: UpdateItemInput!): Item!
  cancelItem(id: ID!): Item!
  createRequest(itemId: ID!, message: String): Request!
  approveRequest(id: ID!): Request!
  declineRequest(id: ID!): Request!
  acceptRequest(id: ID!): Request!
  withdrawRequest(id: ID!): Request!
  completeRequest(id: ID!, rating: Int!): Request!
  deliverRequest(id: ID!): Request!
  disputeRequest(id: ID!): Request!
  sendMessage(requestId: ID!, input: MessageEnvelopeInput!): Message!
  markConversationRead(requestId: ID!, input: MarkConversationReadInput!): MessageReadState!

  markNotificationRead(id: ID!): Notification!
  markAllNotificationsRead: Boolean!
  deleteNotification(id: ID!): Boolean!
  deleteAllNotifications: Boolean!

  presignItemImageUpload: PresignedUpload!
  presignProfilePhotoUpload: PresignedUpload!
  setProfilePhoto(key: String!): User!
  deleteProfilePhoto: Boolean!
  uploadPushToken(input: PushTokenInput!): PushToken!
  deletePushToken(token: String!): Boolean!
  uploadUserKeys(input: UserKeysInput!): UserKeysBundle!
  uploadRatchetPrekeys(input: RatchetPrekeysInput!): RatchetPrekeyStatus!
  putIdentityBackup(input: IdentityBackupInput!): IdentityBackup!
  startPhoneVerification: PhoneVerificationPayload!
  verifyPhone(input: VerifyPhoneInput!): Boolean!
  startPhoneChange(input: StartPhoneChangeInput!): PhoneVerificationPayload!
  verifyPhoneChange(input: VerifyPhoneInput!): User!
  submitMessageReport(input: MessageReportInput!): MessageReport!
  submitStoreKitTransaction(input: StoreKitTransactionInput!): SubscriptionEntitlement!
  ingestAnalyticsEvents(events: AWSJSON!): AnalyticsBatchPayload!
  updateConsents(consents: AWSJSON!): ConsentState!
  changePassword(input: ChangePasswordInput!): Boolean!
  deactivateAccount(input: PasswordStepUpInput!): Boolean!
  deleteAccount(input: PasswordStepUpInput!): DeleteAccountPayload!
}

type Subscription {
  messageCreated(requestId: ID!): Message! @aws_subscribe(mutations: ["sendMessage"])
}

type Viewer {
  id: ID!
  email: String
  displayName: String
  phone: String
  phoneVerified: Boolean!
  emailVerified: Boolean!
  city: String
  birthYear: Int
  gender: String
  profilePhotoUrl: String
  stats: MeStats!
  points(input: PaginationInput): PointsPayload!
  subscription: SubscriptionEntitlement!
  conversations(input: PaginationInput): ConversationConnection!
  notifications(input: PaginationInput): NotificationConnection!
  consents: ConsentState!
}

type AuthPayload @aws_api_key {
  token: String!
  expiresAt: AWSDateTime
  refreshToken: String
  refreshExpiresAt: AWSDateTime
  user: User!
}

type User @aws_api_key @aws_oidc {
  id: ID!
  email: String
  displayName: String
  phone: String
  phoneVerified: Boolean!
  emailVerified: Boolean!
  city: String
  birthYear: Int
  gender: String
  profilePhotoUrl: String
}

type PublicUser {
  id: ID!
  displayName: String
  city: String
  profilePhotoUrl: String
}

type PhoneVerificationPayload {
  expiresAt: AWSDateTime
  verificationCode: String
}

type AnalyticsBatchPayload {
  accepted: Int!
  rejected: Int!
}

type HomePayload {
  meStats: MeStats!
  communityStats: CommunityStats!
  items: ItemConnection!
}

type ItemConnection {
  items: [Item!]!
  nextCursor: String
}

type ItemDetailPayload {
  item: Item!
  subscription: SubscriptionEntitlement!
}

type Item {
  id: ID!
  title: String!
  description: String
  category: String
  images: [String!]!
  editableImages: [ItemEditableImage!]!
  pointValue: Int
  status: String
  owner: PublicUser!
  ownerId: ID!
  ownerDisplayName: String
  approxLat: Float
  approxLng: Float
  exactLat: Float
  exactLng: Float
  ownerContact: String
  queueLength: Int!
  earlyAccessEndsAt: AWSDateTime
  currentRequestCost: Int
  requestIsFree: Boolean!
  freeReason: String
  deliveryRewardPoints: Int
}

type ItemEditableImage {
  key: String!
  url: String!
}

type ConversationConnection {
  conversations: [Conversation!]!
  nextCursor: String
}

type Conversation {
  request: Request!
  item: Item!
  owner: PublicUser!
  requester: PublicUser!
  lastMessage: Message
  unreadCount: Int!
}

type RequestConnection {
  requests: [Request!]!
  nextCursor: String
}

type Request {
  id: ID!
  itemId: ID!
  item: Item
  ownerId: ID!
  owner: PublicUser
  requesterId: ID!
  requester: PublicUser
  status: String!
  message: String
  pointsReserved: Int
  costWaivedReason: String
  rating: Int
  rewardPoints: Int
  rewardGranted: Boolean
  deliveredAt: AWSDateTime
  rewardStatus: String
  rewardEligibleAt: AWSDateTime
  rewardBlockedReason: String
  queuePosition: Int
  deliveryRewardPoints: Int
  createdAt: AWSDateTime
  updatedAt: AWSDateTime
}

type MessageConnection {
  messages: [Message!]!
  viewerReadState: MessageReadState
  counterpartyReadState: MessageReadState
  nextCursor: String
}

type MessageReadState {
  requestId: ID!
  userId: ID!
  lastReadMessageId: ID!
  lastReadMessageCreatedAt: AWSDateTime!
  lastReadAt: AWSDateTime!
}

type Message {
  id: ID!
  requestId: ID!
  senderId: ID!
  createdAt: AWSDateTime
  clientMessageId: ID
  protocolVersion: Int!
  sessionId: String!
  ratchetHeader: RatchetHeader!
  nonce: String!
  ciphertext: String!
  bootstrap: MessageBootstrap
  ciphertextHash: String!
  plaintextHash: String!
  senderSignature: String!
  senderKeyVersion: Int!
  notificationPreview: NotificationPreview
}

type RatchetHeader {
  dhPublicKey: String!
  previousChainLength: Int!
  messageNumber: Int!
  pq: PQRatchetHeader
}

type PQRatchetHeader {
  epoch: Int!
  type: String!
  messageNumber: Int!
  data: String
}

type MessageBootstrap {
  signedX25519PrekeyId: String!
  oneTimeMLKEMPrekeyId: String!
  senderEphemeralPublicKey: String!
  mlkemCiphertext: String!
}

type NotificationPreview {
  version: Int!
  keyId: String!
  kemCiphertext: String!
  nonce: String!
  ciphertext: String!
  signature: String!
}

type NotificationConnection {
  notifications: [Notification!]!
  nextCursor: String
}

type Notification {
  id: ID!
  type: String!
  title: String!
  body: String!
  readAt: AWSDateTime
  createdAt: AWSDateTime
  data: AWSJSON
}

type PointsPayload {
  balance: PointsBalance!
  ledger: [PointsTransaction!]!
  nextCursor: String
}

type PointsBalance {
  userId: ID!
  available: Int!
  updatedAt: AWSDateTime
}

type PointsTransaction {
  id: ID!
  delta: Int!
  reason: String!
  refId: ID
  createdAt: AWSDateTime
}

type StatsPayload {
  me: MeStats!
  community: CommunityStats
}

type MeStats {
  pointsAvailable: Int!
  itemsListed: Int!
  itemsActive: Int!
  itemsCompleted: Int!
  requestsOpen: Int!
  requestsCompleted: Int!
  activeRequests: Int!
  completedDeliveries: Int!
  city: String
}

type CommunityStats {
  availableItems: Int!
  activeDonors: Int!
}

type SubscriptionEntitlement {
  active: Boolean!
  productId: String
  expiresAt: AWSDateTime
  environment: String
  freeEarlyRequestsRemainingToday: Int!
  dailyFreeEarlyRequestLimit: Int!
}

type PresignedUpload {
  key: String!
  uploadUrl: String!
  expiresAt: AWSDateTime!
}

type PushToken {
  userId: ID!
  token: String!
  platform: String!
  updatedAt: AWSDateTime
}

type UserKeysBundle {
  userId: ID!
  mlkemPublicKey: String!
  ed25519PublicKey: String!
  signature: String!
  keyVersion: Int!
  updatedAt: AWSDateTime
  transparency: UserKeysTransparencyProof
}

type UserKeysTransparencyProof {
  entryHash: String!
  previousHash: String
  treeHead: UserKeysSignedTreeHead
  inclusionProof: UserKeysMerkleInclusionProof
}

type UserKeysSignedTreeHead @aws_api_key @aws_oidc {
  treeSize: Int!
  rootHash: String!
  signedAt: String!
  signature: String!
  signingPublicKey: String!
}

type UserKeysMerkleInclusionProof {
  leafIndex: Int!
  treeSize: Int!
  siblingHashes: [String!]!
}

type UserKeysTransparencyHistory {
  entries: [UserKeysTransparencyEntry!]!
}

type UserKeysTransparencyLog @aws_api_key {
  entries: [UserKeysGlobalTransparencyLeaf!]!
}

type UserKeysGlobalTransparencyLeaf @aws_api_key {
  leafIndex: Int!
  leafHash: String!
}

type UserKeysTransparencyEntry {
  userId: ID!
  keyVersion: Int!
  mlkemPublicKey: String!
  ed25519PublicKey: String!
  signature: String!
  previousHash: String
  entryHash: String!
  createdAt: AWSDateTime
}

type SignedRatchetPrekey {
  id: String!
  publicKey: String!
  signature: String!
}

type RatchetPrekeyStatus {
  oneTimeMLKEMPrekeysRemaining: Int!
  replenishBelow: Int!
}

type RatchetBundle {
  userId: ID!
  ed25519PublicKey: String!
  identityKeyVersion: Int!
  signedX25519Prekey: SignedRatchetPrekey!
  oneTimeMLKEMPrekey: SignedRatchetPrekey!
}

type MessageReportConnection {
  reports: [MessageReport!]!
  nextCursor: String
}

type MessageReport {
  id: ID!
  requestId: ID!
  reporterId: ID!
  accusedUserId: ID!
  reason: String!
  note: String
  messages: [MessageReportProof!]!
  createdAt: AWSDateTime!
  status: String!
}

type MessageReportProof {
  messageId: ID!
  senderId: ID!
  createdAt: AWSDateTime!
  plaintext: String!
  plaintextHash: String!
  sessionId: String!
  ciphertextHash: String!
  senderSignature: String!
  senderKeyVersion: Int!
  protocolVersion: Int!
  bootstrapHash: String!
  notificationPreviewHash: String!
  selected: Boolean!
  ratchetHeader: RatchetHeader!
}

type IdentityBackup {
  userId: ID!
  updatedAt: AWSDateTime
  version: Int!
  pwkSalt: String!
  argon2Params: Argon2Params!
  mbkEncrypted: String!
  mbkNonce: String!
  privKeyEncrypted: String!
  privKeyNonce: String!
}

type Argon2Params {
  timeCost: Int!
  memoryKiB: Int!
  threads: Int!
}

type ConsentState {
  consents: AWSJSON!
}

type DeleteAccountPayload {
  status: String!
  scheduledPurgeAt: AWSDateTime
}

input PaginationInput {
  limit: Int = 25
  cursor: String
}

input HomeInput {
  lat: Float!
  lng: Float!
  radiusKm: Float = 10
  limit: Int = 25
  cursor: String
}

input ItemsInput {
  lat: Float!
  lng: Float!
  radiusKm: Float = 10
  limit: Int = 50
  cursor: String
}

input CommunityStatsInput {
  lat: Float!
  lng: Float!
  radiusKm: Float = 10
}

input MessagePageInput {
  limit: Int = 200
  cursor: String
  direction: MessagePageDirection
}

input MarkConversationReadInput {
  lastReadMessageId: ID!
  lastReadMessageCreatedAt: AWSDateTime!
}

enum MessagePageDirection {
  forward
  older
}

input RegisterInput {
  email: String!
  password: String!
  displayName: String!
  phone: String
  city: String
  birthYear: Int
  gender: String
  deviceId: String
  consents: AWSJSON
}

input LoginInput {
  email: String!
  password: String!
  deviceId: String
}

input RefreshSessionInput {
  refreshToken: String!
  deviceId: String
}

input LogoutInput {
  refreshToken: String
}

input VerifyEmailInput {
  email: String!
  token: String!
}

input EmailInput {
  email: String!
}

input ResetPasswordInput {
  email: String!
  token: String!
  newPassword: String!
}

input VerifyPhoneInput {
  code: String!
}

input StartPhoneChangeInput {
  newPhone: String!
  password: String!
}

input CreateItemInput {
  title: String!
  description: String
  category: String
  images: [String!]
  pointValue: Int
  lat: Float!
  lng: Float!
}

input UpdateItemInput {
  title: String
  description: String
  category: String
  images: [String!]
  pointValue: Int
  lat: Float
  lng: Float
}

input MessageEnvelopeInput {
  clientMessageId: ID
  protocolVersion: Int!
  sessionId: String!
  ratchetHeader: RatchetHeaderInput!
  nonce: String!
  ciphertext: String!
  bootstrap: MessageBootstrapInput
  ciphertextHash: String!
  plaintextHash: String!
  senderSignature: String!
  senderKeyVersion: Int!
  notificationPreview: NotificationPreviewInput
}

input RatchetHeaderInput {
  dhPublicKey: String!
  previousChainLength: Int!
  messageNumber: Int!
  pq: PQRatchetHeaderInput
}

input PQRatchetHeaderInput {
  epoch: Int!
  type: String!
  messageNumber: Int!
  data: String
}

input MessageBootstrapInput {
  signedX25519PrekeyId: String!
  oneTimeMLKEMPrekeyId: String!
  senderEphemeralPublicKey: String!
  mlkemCiphertext: String!
}

input NotificationPreviewInput {
  version: Int!
  keyId: String!
  kemCiphertext: String!
  nonce: String!
  ciphertext: String!
  signature: String!
}

input PushTokenInput {
  token: String!
  platform: String!
  environment: String
}

input UserKeysInput {
  mlkemPublicKey: String!
  ed25519PublicKey: String!
  signature: String!
}

input RatchetPrekeysInput {
  signedX25519Prekey: SignedRatchetPrekeyInput!
  oneTimeMLKEMPrekeys: [SignedRatchetPrekeyInput!]!
}

input SignedRatchetPrekeyInput {
  id: String!
  publicKey: String!
  signature: String!
}

input IdentityBackupInput {
  pwkSalt: String!
  argon2Params: Argon2ParamsInput!
  mbkEncrypted: String!
  mbkNonce: String!
  privKeyEncrypted: String!
  privKeyNonce: String!
  expectedVersion: Int
}

input Argon2ParamsInput {
  timeCost: Int!
  memoryKiB: Int!
  threads: Int!
}

input MessageReportInput {
  requestId: ID!
  accusedUserId: ID!
  reason: String!
  note: String
  messages: [MessageReportProofInput!]!
}

input MessageReportProofInput {
  messageId: ID!
  senderId: ID!
  createdAt: AWSDateTime!
  plaintext: String!
  plaintextHash: String!
  sessionId: String!
  ciphertextHash: String!
  senderSignature: String!
  senderKeyVersion: Int!
  protocolVersion: Int!
  bootstrapHash: String!
  notificationPreviewHash: String!
  selected: Boolean!
  ratchetHeader: RatchetHeaderInput!
}

input StoreKitTransactionInput {
  signedTransactionInfo: String!
}

input ChangePasswordInput {
  oldPassword: String!
  newPassword: String!
}

input PasswordStepUpInput {
  password: String!
}
