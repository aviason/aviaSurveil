{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviasurveil360.local/schemas/regulatory-generation-candidate-bundle.schema.json",
  "title": "Governed regulatory generation candidate bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateBundleId", "generationRunId", "status", "generationRequest", "inputDigest", "outputDigest", "complianceMappings", "inspectionChecklist"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "candidateBundleId": {"type": "string", "minLength": 1},
    "generationRunId": {"type": "string", "minLength": 1},
    "status": {"const": "GENERATED_DRAFT"},
    "generationRequest": {"$ref": "regulatory-generation-request.schema.json"},
    "inputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "complianceMappings": {"type": "array", "minItems": 1, "items": {"$ref": "compliance-mapping-candidate.schema.json"}},
    "inspectionChecklist": {"$ref": "inspection-checklist-candidate.schema.json"},
    "sourceCurrentness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentSourceSnapshotId", "currentSourceHash"],
      "properties": {
        "currentSourceSnapshotId": {"type": "string", "minLength": 1},
        "currentSourceHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "previousSourceSnapshotId": {"type": "string", "minLength": 1},
        "previousSourceHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
