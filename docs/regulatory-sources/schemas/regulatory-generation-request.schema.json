{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviasurveil360.local/schemas/regulatory-generation-request.schema.json",
  "title": "Regulatory generation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "organizationId", "serviceProviderScopeFactIds", "serviceProviderTypes", "providerCatalogVersion", "inspectionType", "target", "sourceSnapshots", "secondaryCrosswalkPartition", "unresolvedSourceGaps", "generationPolicyVersion", "providerId", "providerVersion", "requestedOutputs", "canonicalInputDigest"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "requestId": {"type": "string", "pattern": "^GENREQ-[A-Z0-9-]+$"},
    "organizationId": {"type": "string", "minLength": 1},
    "serviceProviderScopeFactIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "serviceProviderTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "providerCatalogVersion": {"const": "1.0.0"},
    "inspectionType": {"type": "string", "minLength": 1},
    "target": {"type": "object", "additionalProperties": false, "required": ["targetId", "kind"], "properties": {"targetId": {"type": "string", "minLength": 1}, "kind": {"enum": ["ORGANIZATION", "PERSON", "FACILITY", "DEVICE", "SYSTEM", "ASSET", "LOCATION"]}}},
    "sourceSnapshots": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["sourceSnapshotId", "sourceHash", "clauseIds", "clauseLocators"], "properties": {"sourceSnapshotId": {"type": "string", "minLength": 1}, "sourceHash": {"$ref": "#/$defs/digest"}, "clauseIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "clauseLocators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "secondaryCrosswalkPartition": {"type": "object", "additionalProperties": false, "required": ["partitionId", "stableRowIds"], "properties": {"partitionId": {"type": "string", "minLength": 1}, "stableRowIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "unresolvedSourceGaps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["gapId", "reason"], "properties": {"gapId": {"enum": ["CONTROLLED_PROCEDURE", "PART_140_AUTHORITY", "PART_127_APPLICABILITY"]}, "reason": {"type": "string", "minLength": 1}}}},
    "generationPolicyVersion": {"type": "string", "minLength": 1},
    "providerId": {"type": "string", "minLength": 1},
    "providerVersion": {"type": "string", "minLength": 1},
    "requestedOutputs": {"const": ["COMPLIANCE_MAPPING", "INSPECTION_CHECKLIST"]},
    "canonicalInputDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
