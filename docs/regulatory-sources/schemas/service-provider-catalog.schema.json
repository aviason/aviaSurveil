{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviasurveil360.local/schemas/service-provider-catalog.schema.json",
  "title": "Service Provider Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "catalogVersion", "source", "targetKinds", "providers"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "catalogId": {"const": "SERVICE_PROVIDER_CATALOG"},
    "catalogVersion": {"const": "1.0.0"},
    "source": {"type": "object", "additionalProperties": false, "required": ["title", "sha256"], "properties": {"title": {"const": "Service Provider matrix"}, "sha256": {"const": "a097081bc74850bce95a87687d9dab228e4f40ef93fd7a65ded11f110998d4e9"}}},
    "targetKinds": {"const": ["ORGANIZATION", "PERSON", "FACILITY", "DEVICE", "SYSTEM", "ASSET", "LOCATION"]},
    "providers": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"oneOf": [
      {"$ref": "#/$defs/AIR_OPERATOR"}, {"$ref": "#/$defs/AMO"}, {"$ref": "#/$defs/CAMO"}, {"$ref": "#/$defs/ATO"}, {"$ref": "#/$defs/FSTD"},
      {"$ref": "#/$defs/AERODROME_OPERATOR"}, {"$ref": "#/$defs/ANSP"}, {"$ref": "#/$defs/CNS_PROVIDER"}, {"$ref": "#/$defs/AIS_AIM_PROVIDER"}, {"$ref": "#/$defs/MET_PROVIDER"},
      {"$ref": "#/$defs/SAR_ORGANIZATION"}, {"$ref": "#/$defs/GROUND_HANDLING"}, {"$ref": "#/$defs/FUEL_PROVIDER"}, {"$ref": "#/$defs/CARGO_REGULATED_AGENT"}, {"$ref": "#/$defs/AVSEC_PROVIDER"},
      {"$ref": "#/$defs/RPAS_UAS_OPERATOR"}, {"$ref": "#/$defs/DOA"}, {"$ref": "#/$defs/POA"}, {"$ref": "#/$defs/AEMC"}, {"$ref": "#/$defs/AME"}
    ]}}
  },
  "allOf": [
    {"properties": {"providers": {"contains": {"$ref": "#/$defs/AIR_OPERATOR"}}}}, {"properties": {"providers": {"contains": {"$ref": "#/$defs/AMO"}}}},
    {"properties": {"providers": {"contains": {"$ref": "#/$defs/CAMO"}}}}, {"properties": {"providers": {"contains": {"$ref": "#/$defs/ATO"}}}},
    {"properties": {"providers": {"contains": {"$ref": "#/$defs/FSTD"}}}}, {"properties": {"providers": {"contains": {"$ref": "#/$defs/AERODROME_OPERATOR"}}}},
    {"properties": {"providers": {"contains": {"$ref": "#/$defs/ANSP"}}}}, {"properties": {"providers": {"contains": {"$ref": "#/$defs/CNS_PROVIDER"}}}},
    {"properties": {"providers": {"contains": {"$ref": "#/$defs/AIS_AIM_PROVIDER"}}}}, {"properties": {"providers": {"contains": {"$ref": "#/$defs/MET_PROVIDER"}}}},
    {"properties": {"providers": {"contains": {"$ref": "#/$defs/SAR_ORGANIZATION"}}}}, {"properties": {"providers": {"contains": {"$ref": "#/$defs/GROUND_HANDLING"}}}},
    {"properties": {"providers": {"contains": {"$ref": "#/$defs/FUEL_PROVIDER"}}}}, {"properties": {"providers": {"contains": {"$ref": "#/$defs/CARGO_REGULATED_AGENT"}}}},
    {"properties": {"providers": {"contains": {"$ref": "#/$defs/AVSEC_PROVIDER"}}}}, {"properties": {"providers": {"contains": {"$ref": "#/$defs/RPAS_UAS_OPERATOR"}}}},
    {"properties": {"providers": {"contains": {"$ref": "#/$defs/DOA"}}}}, {"properties": {"providers": {"contains": {"$ref": "#/$defs/POA"}}}},
    {"properties": {"providers": {"contains": {"$ref": "#/$defs/AEMC"}}}}, {"properties": {"providers": {"contains": {"$ref": "#/$defs/AME"}}}}
  ],
  "$defs": {
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "label", "aliases", "rawOversightTopics", "topics", "rawResponsibleCaaUnit", "targetKinds", "responsibility"],
      "properties": {
        "code": {"type": "string"}, "label": {"type": "string"}, "aliases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rawOversightTopics": {"type": "string"}, "topics": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "rawResponsibleCaaUnit": {"type": "string"},
        "targetKinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ORGANIZATION", "PERSON", "FACILITY", "DEVICE", "SYSTEM", "ASSET", "LOCATION"]}},
        "responsibility": {"type": "object", "additionalProperties": false, "required": ["normalizationStatus"], "properties": {"normalizationStatus": {"enum": ["NORMALIZED", "REVIEW_REQUIRED"]}, "relationship": {"enum": ["PRIMARY", "JOINT", "CONSULTED"]}, "normalizedParentApprovalDepartment": {"type": "string"}, "approvalRequired": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}
      },
      "allOf": [{
        "if": {"properties": {"rawResponsibleCaaUnit": {"pattern": "[+/]"}}},
        "then": {"properties": {"responsibility": {"properties": {"normalizationStatus": {"const": "REVIEW_REQUIRED"}}, "not": {"anyOf": [{"required": ["relationship"]}, {"required": ["normalizedParentApprovalDepartment"]}, {"required": ["approvalRequired"]}]}}}},
        "else": {"properties": {"responsibility": {"properties": {"normalizationStatus": {"const": "NORMALIZED"}}, "required": ["relationship", "normalizedParentApprovalDepartment", "approvalRequired"]}}}
      }]
    },
    "AIR_OPERATOR": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "AIR_OPERATOR"}, "label": {"const": "Air Operator (AOC Holder)"}, "rawOversightTopics": {"const": "Flight Operations; Cabin Safety; Operational Control; Crew Training; Dangerous Goods; SMS; Security; Manuals"}, "topics": {"const": ["Flight Operations", "Cabin Safety", "Operational Control", "Crew Training", "Dangerous Goods", "SMS", "Security", "Manuals"]}, "rawResponsibleCaaUnit": {"const": "Flight Operations Inspectorate (FOI)"}, "targetKinds": {"const": ["ORGANIZATION"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Flight Operations Inspectorate (FOI)", "approvalRequired": ["FLIGHT_OPERATIONS_INSPECTORATE"]}}}}]},
    "AMO": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "AMO"}, "label": {"const": "Approved Maintenance Organization (AMO)"}, "rawOversightTopics": {"const": "Maintenance Procedures; Personnel; Tooling; Facilities; Quality System; SMS; Records"}, "topics": {"const": ["Maintenance Procedures", "Personnel", "Tooling", "Facilities", "Quality System", "SMS", "Records"]}, "rawResponsibleCaaUnit": {"const": "Airworthiness Inspectorate"}, "targetKinds": {"const": ["ORGANIZATION", "FACILITY"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Airworthiness Inspectorate", "approvalRequired": ["AIRWORTHINESS_INSPECTORATE"]}}}}]},
    "CAMO": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "CAMO"}, "label": {"const": "Continuing Airworthiness Management Organization (CAMO)"}, "rawOversightTopics": {"const": "Airworthiness Management; Maintenance Programme; Reliability Programme; Technical Records"}, "topics": {"const": ["Airworthiness Management", "Maintenance Programme", "Reliability Programme", "Technical Records"]}, "rawResponsibleCaaUnit": {"const": "Airworthiness Inspectorate"}, "targetKinds": {"const": ["ORGANIZATION"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Airworthiness Inspectorate", "approvalRequired": ["AIRWORTHINESS_INSPECTORATE"]}}}}]},
    "ATO": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "ATO"}, "label": {"const": "Approved Training Organization (ATO)"}, "rawOversightTopics": {"const": "Training Programmes; Instructors; Examinations; Training Records; Simulators"}, "topics": {"const": ["Training Programmes", "Instructors", "Examinations", "Training Records", "Simulators"]}, "rawResponsibleCaaUnit": {"const": "Personnel Licensing & Training Department"}, "targetKinds": {"const": ["ORGANIZATION", "FACILITY"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Personnel Licensing & Training Department", "approvalRequired": ["PERSONNEL_LICENSING_AND_TRAINING_DEPARTMENT"]}}}}]},
    "FSTD": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "FSTD"}, "label": {"const": "Flight Simulation Training Device (FSTD)"}, "rawOversightTopics": {"const": "Simulator Qualification; Configuration; Maintenance; Records"}, "topics": {"const": ["Simulator Qualification", "Configuration", "Maintenance", "Records"]}, "rawResponsibleCaaUnit": {"const": "Personnel Licensing & Training Department"}, "targetKinds": {"const": ["DEVICE", "FACILITY"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Personnel Licensing & Training Department", "approvalRequired": ["PERSONNEL_LICENSING_AND_TRAINING_DEPARTMENT"]}}}}]},
    "AERODROME_OPERATOR": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "AERODROME_OPERATOR"}, "label": {"const": "Aerodrome Operator"}, "rawOversightTopics": {"const": "Runways; Taxiways; Aprons; Lighting; RFFS; Wildlife; Obstacle Control; Emergency Plan; SMS"}, "topics": {"const": ["Runways", "Taxiways", "Aprons", "Lighting", "RFFS", "Wildlife", "Obstacle Control", "Emergency Plan", "SMS"]}, "rawResponsibleCaaUnit": {"const": "Aerodrome Inspectorate"}, "targetKinds": {"const": ["ORGANIZATION", "FACILITY", "LOCATION"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Aerodrome Inspectorate", "approvalRequired": ["AERODROME_INSPECTORATE"]}}}}]},
    "ANSP": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "ANSP"}, "label": {"const": "Air Navigation Service Provider (ANSP)"}, "rawOversightTopics": {"const": "ATS; ATC Procedures; Airspace Management; SMS; Contingency Plans"}, "topics": {"const": ["ATS", "ATC Procedures", "Airspace Management", "SMS", "Contingency Plans"]}, "rawResponsibleCaaUnit": {"const": "Air Navigation Services Inspectorate"}, "targetKinds": {"const": ["ORGANIZATION", "SYSTEM"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Air Navigation Services Inspectorate", "approvalRequired": ["AIR_NAVIGATION_SERVICES_INSPECTORATE"]}}}}]},
    "CNS_PROVIDER": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "CNS_PROVIDER"}, "label": {"const": "Communication Service Provider (CNS)"}, "rawOversightTopics": {"const": "Communication Systems; Navigation Aids; Surveillance Systems; Maintenance"}, "topics": {"const": ["Communication Systems", "Navigation Aids", "Surveillance Systems", "Maintenance"]}, "rawResponsibleCaaUnit": {"const": "CNS Inspectorate"}, "targetKinds": {"const": ["ORGANIZATION", "SYSTEM", "ASSET"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "CNS Inspectorate", "approvalRequired": ["CNS_INSPECTORATE"]}}}}]},
    "AIS_AIM_PROVIDER": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "AIS_AIM_PROVIDER"}, "label": {"const": "AIS/AIM Provider"}, "rawOversightTopics": {"const": "AIP; NOTAM; Charts; Data Quality; Digital AIM"}, "topics": {"const": ["AIP", "NOTAM", "Charts", "Data Quality", "Digital AIM"]}, "rawResponsibleCaaUnit": {"const": "AIS/AIM Inspectorate"}, "targetKinds": {"const": ["ORGANIZATION", "SYSTEM"]}, "responsibility": {"const": {"normalizationStatus": "REVIEW_REQUIRED"}}}}]},
    "MET_PROVIDER": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "MET_PROVIDER"}, "label": {"const": "Meteorological Service Provider (MET)"}, "rawOversightTopics": {"const": "Aviation Weather Services; Forecasting; Observations; MET Reports"}, "topics": {"const": ["Aviation Weather Services", "Forecasting", "Observations", "MET Reports"]}, "rawResponsibleCaaUnit": {"const": "Meteorological Oversight Unit"}, "targetKinds": {"const": ["ORGANIZATION", "SYSTEM", "FACILITY"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Meteorological Oversight Unit", "approvalRequired": ["METEOROLOGICAL_OVERSIGHT_UNIT"]}}}}]},
    "SAR_ORGANIZATION": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "SAR_ORGANIZATION"}, "label": {"const": "Search and Rescue (SAR) Organization"}, "rawOversightTopics": {"const": "Rescue Coordination; SAR Plans; Exercises; Readiness"}, "topics": {"const": ["Rescue Coordination", "SAR Plans", "Exercises", "Readiness"]}, "rawResponsibleCaaUnit": {"const": "SAR Oversight Unit"}, "targetKinds": {"const": ["ORGANIZATION", "FACILITY", "LOCATION"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "SAR Oversight Unit", "approvalRequired": ["SAR_OVERSIGHT_UNIT"]}}}}]},
    "GROUND_HANDLING": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "GROUND_HANDLING"}, "label": {"const": "Ground Handling Organization"}, "rawOversightTopics": {"const": "Passenger Handling; Ramp Operations; Load Control; Baggage; Aircraft Servicing; SMS"}, "topics": {"const": ["Passenger Handling", "Ramp Operations", "Load Control", "Baggage", "Aircraft Servicing", "SMS"]}, "rawResponsibleCaaUnit": {"const": "Ground Operations / Flight Operations Inspectorate"}, "targetKinds": {"const": ["ORGANIZATION", "FACILITY"]}, "responsibility": {"const": {"normalizationStatus": "REVIEW_REQUIRED"}}}}]},
    "FUEL_PROVIDER": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "FUEL_PROVIDER"}, "label": {"const": "Fuel Service Provider"}, "rawOversightTopics": {"const": "Fuel Storage; Fuel Quality; Refuelling Procedures; Equipment; Personnel"}, "topics": {"const": ["Fuel Storage", "Fuel Quality", "Refuelling Procedures", "Equipment", "Personnel"]}, "rawResponsibleCaaUnit": {"const": "Aerodrome Inspectorate"}, "targetKinds": {"const": ["ORGANIZATION", "FACILITY", "ASSET", "LOCATION"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Aerodrome Inspectorate", "approvalRequired": ["AERODROME_INSPECTORATE"]}}}}]},
    "CARGO_REGULATED_AGENT": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "CARGO_REGULATED_AGENT"}, "label": {"const": "Cargo Terminal / Regulated Agent"}, "rawOversightTopics": {"const": "Cargo Acceptance; Dangerous Goods; Security Controls; Documentation"}, "topics": {"const": ["Cargo Acceptance", "Dangerous Goods", "Security Controls", "Documentation"]}, "rawResponsibleCaaUnit": {"const": "Aviation Security (AVSEC) + Dangerous Goods Office"}, "targetKinds": {"const": ["ORGANIZATION", "FACILITY"]}, "responsibility": {"const": {"normalizationStatus": "REVIEW_REQUIRED"}}}}]},
    "AVSEC_PROVIDER": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "AVSEC_PROVIDER"}, "label": {"const": "Aviation Security Service Provider"}, "rawOversightTopics": {"const": "Passenger Screening; Access Control; Hold Baggage Screening; Staff Training"}, "topics": {"const": ["Passenger Screening", "Access Control", "Hold Baggage Screening", "Staff Training"]}, "rawResponsibleCaaUnit": {"const": "AVSEC Inspectorate"}, "targetKinds": {"const": ["ORGANIZATION", "FACILITY"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "AVSEC Inspectorate", "approvalRequired": ["AVSEC_INSPECTORATE"]}}}}]},
    "RPAS_UAS_OPERATOR": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "RPAS_UAS_OPERATOR"}, "label": {"const": "RPAS/UAS Operator"}, "rawOversightTopics": {"const": "Flight Operations; Remote Pilot Competency; Maintenance; Operational Risk Assessment; C2 Link"}, "topics": {"const": ["Flight Operations", "Remote Pilot Competency", "Maintenance", "Operational Risk Assessment", "C2 Link"]}, "rawResponsibleCaaUnit": {"const": "RPAS / Flight Operations Inspectorate"}, "targetKinds": {"const": ["ORGANIZATION", "DEVICE", "SYSTEM"]}, "responsibility": {"const": {"normalizationStatus": "REVIEW_REQUIRED"}}}}]},
    "DOA": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "DOA"}, "label": {"const": "Aircraft Design Organization (DOA)"}, "rawOversightTopics": {"const": "Design Approval; Compliance Demonstration; Configuration Control"}, "topics": {"const": ["Design Approval", "Compliance Demonstration", "Configuration Control"]}, "rawResponsibleCaaUnit": {"const": "Airworthiness Certification Department"}, "targetKinds": {"const": ["ORGANIZATION"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Airworthiness Certification Department", "approvalRequired": ["AIRWORTHINESS_CERTIFICATION_DEPARTMENT"]}}}}]},
    "POA": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "POA"}, "label": {"const": "Production Organization (POA)"}, "rawOversightTopics": {"const": "Production System; Quality Assurance; Product Conformity"}, "topics": {"const": ["Production System", "Quality Assurance", "Product Conformity"]}, "rawResponsibleCaaUnit": {"const": "Airworthiness Certification Department"}, "targetKinds": {"const": ["ORGANIZATION", "FACILITY"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Airworthiness Certification Department", "approvalRequired": ["AIRWORTHINESS_CERTIFICATION_DEPARTMENT"]}}}}]},
    "AEMC": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "AEMC"}, "label": {"const": "Aviation Medical Centre (AeMC)"}, "rawOversightTopics": {"const": "Medical Facilities; Equipment; Medical Records; Personnel"}, "topics": {"const": ["Medical Facilities", "Equipment", "Medical Records", "Personnel"]}, "rawResponsibleCaaUnit": {"const": "Aeromedical Department"}, "targetKinds": {"const": ["ORGANIZATION", "FACILITY"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Aeromedical Department", "approvalRequired": ["AEROMEDICAL_DEPARTMENT"]}}}}]},
    "AME": {"allOf": [{"$ref": "#/$defs/provider"}, {"properties": {"code": {"const": "AME"}, "label": {"const": "Aviation Medical Examiner (AME)"}, "rawOversightTopics": {"const": "Medical Examinations; Certification Procedures; Record Keeping"}, "topics": {"const": ["Medical Examinations", "Certification Procedures", "Record Keeping"]}, "rawResponsibleCaaUnit": {"const": "Aeromedical Department"}, "targetKinds": {"const": ["PERSON"]}, "responsibility": {"const": {"normalizationStatus": "NORMALIZED", "relationship": "PRIMARY", "normalizedParentApprovalDepartment": "Aeromedical Department", "approvalRequired": ["AEROMEDICAL_DEPARTMENT"]}}}}]}
  }
}
