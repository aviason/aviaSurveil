{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviasurveil360.local/schemas/inspection-checklist-candidate.schema.json",
  "title": "Inspection checklist candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["checklistId", "questions"],
  "properties": {
    "checklistId": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "mappingIds", "prompt", "citations", "verificationMethod", "expectedEvidence", "allowedAnswers", "mandatoryCore", "safetyCritical", "origin", "scopeRecommendation", "regulatoryTrace", "reconciliation"],
      "properties": {
        "questionId": {"type": "string", "minLength": 1},
        "mappingIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prompt": {"type": "string", "minLength": 1},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}},
        "verificationMethod": {"type": "string", "minLength": 1},
        "expectedEvidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowedAnswers": {"const": ["COMPLIANT", "NON_COMPLIANT", "OBSERVATION", "NOT_APPLICABLE", "NOT_CHECKED"]},
        "mandatoryCore": {"type": "boolean"},
        "safetyCritical": {"type": "boolean"},
        "origin": {"type": "string", "enum": ["REGULATORY_TRACE", "EXISTING_CHECKLIST_CANDIDATE", "HYBRID_RECONCILED"]},
        "scopeRecommendation": {"$ref": "#/$defs/scopeRecommendation"},
        "regulatoryTrace": {"$ref": "#/$defs/regulatoryTrace"},
        "reconciliation": {"anyOf": [{"$ref": "#/$defs/reconciliation"}, {"type": "null"}]}
      }
    },
    "scopeRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "inputSignals", "operationalHistoryBasis", "rationale", "guardrails", "approvalReviewState", "automaticDeferral"],
      "properties": {
        "classification": {"type": "string", "enum": ["MANDATORY_CORE", "FOCUSED_FULL", "ROTATIONAL_SAMPLE", "DEFER_ELIGIBLE"]},
        "inputSignals": {"type": "array", "items": {"type": "string"}},
        "operationalHistoryBasis": {"type": "string"},
        "rationale": {"type": "string"},
        "guardrails": {"$ref": "#/$defs/scopeGuardrails"},
        "approvalReviewState": {"type": "string", "enum": ["TECHNICAL_REVIEW_REQUIRED", "TECHNICALLY_APPROVED"]},
        "automaticDeferral": {"type": "boolean"}
      }
    },
    "scopeGuardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mandatoryControl", "safetyCritical", "unknownHistory", "sourceChanged", "overdueControl", "automaticDeferralPermitted"],
      "properties": {
        "mandatoryControl": {"type": "boolean"},
        "safetyCritical": {"type": "boolean"},
        "unknownHistory": {"type": "boolean"},
        "sourceChanged": {"type": "boolean"},
        "overdueControl": {"type": "boolean"},
        "automaticDeferralPermitted": {"type": "boolean"}
      }
    },
    "regulatoryTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"type": "string", "enum": ["RESOLVED", "SOURCE_MAPPING_REQUIRED"]},
        "sourceIdentity": {"type": "string"},
        "sourceTitle": {"type": "string"},
        "immutableVersion": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "locator": {"type": "string"},
        "page": {"type": "string"},
        "section": {"type": "string"},
        "clause": {"type": "string"},
        "sourceType": {"type": "string"},
        "applicability": {"type": "string"},
        "nationalReference": {"type": "string"},
        "controlledCaaProcedureMapping": {"type": "string"},
        "verificationObjective": {"type": "string"},
        "expectedEvidence": {"type": "array", "items": {"type": "string"}},
        "currentnessState": {"type": "string", "enum": ["CURRENT", "STALE", "SOURCE_MAPPING_REQUIRED"]},
        "technicalReviewState": {"type": "string", "enum": ["TECHNICAL_REVIEW_REQUIRED", "TECHNICALLY_APPROVED", "NOT_AVAILABLE"]}
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacyQuestionId", "legacyWording", "legacyOperationalIntent", "legacyResultHistory", "legacyExpectedEvidence", "legacyApplicability", "legacyScopeClassification", "currentWording", "currentExpectedEvidence", "currentApplicability", "currentScopeClassification", "wordingChanged", "evidenceChanged", "applicabilityChanged", "scopeChanged"],
      "properties": {
        "legacyQuestionId": {"type": "string"},
        "legacyWording": {"type": "string"},
        "legacyOperationalIntent": {"type": "string"},
        "legacyResultHistory": {"type": "string"},
        "legacyExpectedEvidence": {"type": "array", "items": {"type": "string"}},
        "legacyApplicability": {"type": "string"},
        "legacyScopeClassification": {"type": "string"},
        "currentWording": {"type": "string"},
        "currentExpectedEvidence": {"type": "array", "items": {"type": "string"}},
        "currentApplicability": {"type": "string"},
        "currentScopeClassification": {"type": "string"},
        "wordingChanged": {"type": "boolean"},
        "evidenceChanged": {"type": "boolean"},
        "applicabilityChanged": {"type": "boolean"},
        "scopeChanged": {"type": "boolean"}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSnapshotId", "sourceHash", "clauseId", "locator"],
      "properties": {
        "sourceSnapshotId": {"type": "string", "minLength": 1},
        "sourceHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "clauseId": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}
      }
    }
  }
}
