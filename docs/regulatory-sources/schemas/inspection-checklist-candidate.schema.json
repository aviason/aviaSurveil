{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviasurveil360.local/schemas/inspection-checklist-candidate.schema.json",
  "title": "Inspection checklist candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["checklistId", "questions"],
  "properties": {
    "checklistId": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {"question": {"type": "object", "additionalProperties": false, "required": ["questionId", "mappingIds", "prompt", "citations", "verificationMethod", "expectedEvidence", "allowedAnswers", "mandatoryCore", "safetyCritical"], "properties": {"questionId": {"type": "string", "minLength": 1}, "mappingIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "prompt": {"type": "string", "minLength": 1}, "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}, "verificationMethod": {"type": "string", "minLength": 1}, "expectedEvidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "allowedAnswers": {"const": ["COMPLIANT", "NON_COMPLIANT", "OBSERVATION", "NOT_APPLICABLE", "NOT_CHECKED"]}, "mandatoryCore": {"type": "boolean"}, "safetyCritical": {"type": "boolean"}}}, "citation": {"type": "object", "additionalProperties": false, "required": ["sourceSnapshotId", "sourceHash", "clauseId", "locator"], "properties": {"sourceSnapshotId": {"type": "string", "minLength": 1}, "sourceHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "clauseId": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}}}}
}
