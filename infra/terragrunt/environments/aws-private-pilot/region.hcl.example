# Shape-only owner overlay. Do not commit a populated copy or secret values.
locals {
  fixture_mode                  = false
  remote_actions_authorized    = false
  aws_profile                   = "avia"
  account_id                   = get_env("AVIA_AWS_PRIVATE_PILOT_ACCOUNT_ID", "")
  region                       = get_env("AVIA_AWS_PRIVATE_PILOT_REGION", "eu-central-1")
  availability_zones           = try(jsondecode(get_env("AVIA_AWS_PRIVATE_PILOT_AVAILABILITY_ZONES", "[]")), [])
  state_bucket_name            = get_env("AVIA_AWS_PRIVATE_PILOT_STATE_BUCKET_NAME", "")
  state_kms_key_arn            = get_env("AVIA_AWS_PRIVATE_PILOT_STATE_KMS_KEY_ARN", "")
  name                         = get_env("AVIA_AWS_PRIVATE_PILOT_NAME", "")
  kms_alias_prefix             = get_env("AVIA_AWS_PRIVATE_PILOT_KMS_ALIAS_PREFIX", "aviasurveil360-private-pilot")
  vpc_cidr                     = get_env("AVIA_AWS_PRIVATE_PILOT_VPC_CIDR", "")
  dual_stack_app_subnet_cidr   = get_env("AVIA_AWS_PRIVATE_PILOT_DUAL_STACK_APP_SUBNET_CIDR", "")
  private_database_subnet_cidrs = try(jsondecode(get_env("AVIA_AWS_PRIVATE_PILOT_PRIVATE_DATABASE_SUBNET_CIDRS", "[]")), [])
  cloudflare_account_id        = get_env("AVIA_AWS_PRIVATE_PILOT_CLOUDFLARE_ACCOUNT_ID", "")
  cloudflare_zone_id           = get_env("AVIA_AWS_PRIVATE_PILOT_CLOUDFLARE_ZONE_ID", "")
  cloudflare_tunnel_name       = get_env("AVIA_AWS_PRIVATE_PILOT_CLOUDFLARE_TUNNEL_NAME", "")
  cloudflare_dns_cutover_authorized = get_env("AVIA_AWS_PRIVATE_PILOT_CLOUDFLARE_DNS_CUTOVER_AUTHORIZED", "false") == "true"
  cloudflare_connector_parameter_name = get_env("AVIA_AWS_PRIVATE_PILOT_CLOUDFLARE_CONNECTOR_PARAMETER_NAME", "/aviasurveil360/private-pilot/cloudflare/tunnel-token")
  cloudflare_tunnel_ipv6_cidrs = try(toset(jsondecode(get_env("AVIA_AWS_PRIVATE_PILOT_CLOUDFLARE_TUNNEL_IPV6_CIDRS", "[]"))), toset([]))
  hostname                     = get_env("AVIA_AWS_PRIVATE_PILOT_HOSTNAME", "")
  ami_id                       = get_env("AVIA_AWS_PRIVATE_PILOT_AMI_ID", "")
  instance_type                = get_env("AVIA_AWS_PRIVATE_PILOT_INSTANCE_TYPE", "")
  root_volume_size_gib         = try(tonumber(get_env("AVIA_AWS_PRIVATE_PILOT_ROOT_VOLUME_SIZE_GIB", "")), null)
  release_manifest_sha256      = get_env("AVIA_AWS_PRIVATE_PILOT_RELEASE_MANIFEST_SHA256", "")
  database_engine_version      = get_env("AVIA_AWS_PRIVATE_PILOT_DATABASE_ENGINE_VERSION", "")
  database_allocated_storage_gib = try(tonumber(get_env("AVIA_AWS_PRIVATE_PILOT_DATABASE_ALLOCATED_STORAGE_GIB", "")), null)
  smtp_port                    = try(tonumber(get_env("AVIA_AWS_PRIVATE_PILOT_SMTP_PORT", "")), null)
  smtp_ipv6_cidrs              = try(toset(jsondecode(get_env("AVIA_AWS_PRIVATE_PILOT_SMTP_IPV6_CIDRS", "[]"))), toset([]))
  bucket_name_prefix           = get_env("AVIA_AWS_PRIVATE_PILOT_BUCKET_NAME_PREFIX", "")
  budget_monthly_usd           = try(tonumber(get_env("AVIA_AWS_PRIVATE_PILOT_BUDGET_MONTHLY_USD", "")), null)
  tags = {
    Environment        = "production"
    Owner              = get_env("AVIA_AWS_PRIVATE_PILOT_OWNER", "")
    CostCenter         = get_env("AVIA_AWS_PRIVATE_PILOT_COST_CENTER", "")
    DataClassification = get_env("AVIA_AWS_PRIVATE_PILOT_DATA_CLASSIFICATION", "")
    ManagedBy          = "terraform"
  }
}
