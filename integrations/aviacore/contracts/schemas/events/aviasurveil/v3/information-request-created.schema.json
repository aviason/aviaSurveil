{
  "$id": "https://aviacore360.local/schemas/events/aviasurveil/v3/information-request-created.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "properties": {
        "entity_refs": {
          "additionalProperties": false,
          "properties": {
            "audit_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "finding_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "request_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "audit_id",
            "finding_id",
            "request_id"
          ],
          "type": "object"
        },
        "event_type": {
          "const": "information_request.created"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "due_at": {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            "request_reason_code": {
              "maxLength": 64,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            }
          },
          "required": [
            "request_reason_code",
            "due_at"
          ],
          "type": "object"
        },
        "state_after": {
          "enum": [
            "information_requested"
          ]
        },
        "state_before": {
          "enum": [
            "finding_open",
            "cap_under_review",
            "evidence_under_review"
          ]
        }
      },
      "type": "object"
    }
  ],
  "title": "information_request.created v1"
}
