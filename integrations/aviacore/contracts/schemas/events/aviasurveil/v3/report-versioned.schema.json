{
  "$id": "https://aviacore360.local/schemas/events/aviasurveil/v3/report-versioned.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "properties": {
        "entity_refs": {
          "additionalProperties": false,
          "properties": {
            "report_id": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "report_id"
          ],
          "type": "object"
        },
        "event_type": {
          "const": "report.versioned"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "report_digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "report_id": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "report_revision": {
              "minimum": 0,
              "type": "integer"
            },
            "report_status_code": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "report_id",
            "report_revision",
            "report_status_code",
            "report_digest"
          ],
          "type": "object"
        },
        "state_after": {
          "const": "report_versioned"
        },
        "state_before": {
          "enum": [
            null
          ]
        }
      },
      "type": "object"
    }
  ],
  "title": "report.versioned v3"
}
