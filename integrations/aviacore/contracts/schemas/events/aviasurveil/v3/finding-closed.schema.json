{
  "$id": "https://aviacore360.local/schemas/events/aviasurveil/v3/finding-closed.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "allOf": [
        {
          "if": {
            "properties": {
              "payload": {
                "properties": {
                  "closure_basis": {
                    "const": "verified_evidence"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "evidence_ref_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "evidence_ref_id"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "entity_refs": {
          "additionalProperties": false,
          "properties": {
            "audit_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "finding_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "audit_id",
            "finding_id"
          ],
          "type": "object"
        },
        "event_type": {
          "const": "finding.closed"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "closed_at": {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            "closure_authority_ref": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "closure_basis": {
              "enum": [
                "verified_evidence",
                "authorized_closure"
              ]
            },
            "evidence_ref_id": {
              "maxLength": 128,
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "closure_basis",
            "closure_authority_ref",
            "evidence_ref_id",
            "closed_at"
          ],
          "type": "object"
        },
        "state_after": {
          "enum": [
            "finding_closed"
          ]
        },
        "state_before": {
          "enum": [
            "evidence_verified",
            "finding_escalated"
          ]
        }
      },
      "type": "object"
    }
  ],
  "title": "finding.closed v1"
}
