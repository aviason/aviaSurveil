{
  "$id": "https://aviacore360.local/schemas/events/aviasurveil/v3/regulatory_reference-versioned.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "properties": {
        "entity_refs": {
          "additionalProperties": false,
          "properties": {
            "reference_id": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "reference_id"
          ],
          "type": "object"
        },
        "event_type": {
          "const": "regulatory_reference.versioned"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "provision_reference_codes": {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array"
            },
            "reference_id": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "reference_revision": {
              "minimum": 0,
              "type": "integer"
            },
            "source_content_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "source_uri": {
              "maxLength": 2048,
              "pattern": "^https://[A-Za-z0-9._:/?=&%-]+$",
              "type": "string"
            }
          },
          "required": [
            "reference_id",
            "reference_revision",
            "source_uri",
            "source_content_sha256",
            "provision_reference_codes"
          ],
          "type": "object"
        },
        "state_after": {
          "const": "reference_versioned"
        },
        "state_before": {
          "enum": [
            null
          ]
        }
      },
      "type": "object"
    }
  ],
  "title": "regulatory_reference.versioned v3"
}
