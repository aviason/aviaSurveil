{
  "$id": "https://aviacore360.local/schemas/events/aviasurveil/v3/tombstone-recorded.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "properties": {
        "entity_refs": {
          "additionalProperties": false,
          "properties": {
            "tombstoned_event_id": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "tombstoned_event_id"
          ],
          "type": "object"
        },
        "event_type": {
          "const": "tombstone.recorded"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "suppression_scope_code": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "tombstone_reason_code": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "tombstoned_event_id": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "tombstoned_event_id",
            "suppression_scope_code",
            "tombstone_reason_code"
          ],
          "type": "object"
        },
        "state_after": {
          "maxLength": 64,
          "type": "string"
        },
        "state_before": {
          "maxLength": 64,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  ],
  "title": "event.superseded v1"
}
