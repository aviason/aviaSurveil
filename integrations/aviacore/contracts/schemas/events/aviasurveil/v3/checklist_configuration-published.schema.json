                    "minItems": 1,
                    "type": "array"
                  },
                  "citation_reference_ids": {
                    "items": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "expected_evidence_type_codes": {
                    "items": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "mandatory": {
                    "type": "boolean"
                  },
                  "mapping_reference_ids": {
                    "items": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "ordinal": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "prompt": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "question_id": {
                    "maxLength": 256,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                    "type": "string"
                  },
                  "safety_critical": {
                    "type": "boolean"
                  },
                  "verification_method_code": {
                    "maxLength": 256,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                    "type": "string"
                  }
