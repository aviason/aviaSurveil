{
  "$id": "https://aviacore360.local/schemas/events/aviasurveil/v3/checklist_configuration-published.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "properties": {
        "entity_refs": {
          "additionalProperties": false,
          "properties": {
            "configuration_id": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "publication_decision_id": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "configuration_id",
            "publication_decision_id"
          ],
          "type": "object"
        },
        "event_type": {
          "const": "checklist_configuration.published"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "configuration_digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "configuration_id": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "configuration_revision": {
              "minimum": 0,
              "type": "integer"
            },
            "ordered_question_snapshot": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "allowed_answer_codes": {
                    "items": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                      "type": "string"
