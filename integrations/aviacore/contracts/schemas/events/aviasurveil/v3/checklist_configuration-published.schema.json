              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "configuration_id",
            "configuration_revision",
            "configuration_digest",
            "publication_decision_id",
            "publication_decision_code",
            "published_at",
            "provider_scope_ref",
            "typed_target_ref",
            "qualifier_codes",
            "ordered_question_snapshot",
            "question_count"
          ],
          "type": "object"
        },
        "state_after": {
          "const": "configuration_published"
        },
        "state_before": {
          "enum": [
            null
          ]
        }
      },
      "type": "object"
    }
