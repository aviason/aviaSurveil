{
  "$id": "https://aviacore360.local/schemas/events/aviasurveil/v3/checklist-response-recorded.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "properties": {
        "entity_refs": {
          "additionalProperties": false,
          "properties": {
            "audit_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "checklist_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "audit_id",
            "checklist_id"
          ],
          "type": "object"
        },
        "event_type": {
          "const": "checklist.response_recorded"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "checklist_item_ref": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "finding_required": {
              "type": "boolean"
            },
            "response_code": {
              "enum": [
                "conforming",
                "nonconforming",
                "not_applicable"
              ]
            }
          },
          "required": [
            "checklist_item_ref",
            "response_code",
            "finding_required"
          ],
          "type": "object"
        },
        "state_after": {
          "enum": [
            "audit_in_progress"
          ]
        },
        "state_before": {
          "enum": [
            "audit_in_progress"
          ]
        }
      },
      "type": "object"
    }
  ],
  "title": "checklist.response_recorded v1"
}
