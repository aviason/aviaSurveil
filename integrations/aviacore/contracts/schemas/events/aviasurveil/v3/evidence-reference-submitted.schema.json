{
  "$id": "https://aviacore360.local/schemas/events/aviasurveil/v3/evidence-reference-submitted.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "properties": {
        "entity_refs": {
          "additionalProperties": false,
          "properties": {
            "audit_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "evidence_ref_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "finding_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "audit_id",
            "finding_id",
            "evidence_ref_id"
          ],
          "type": "object"
        },
        "event_type": {
          "const": "evidence_reference.submitted"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "checksum_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "media_type": {
              "enum": [
                "application/pdf",
                "image/png",
                "image/jpeg",
                "application/octet-stream"
              ]
            },
            "object_version": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "purpose_code": {
              "maxLength": 64,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            }
          },
          "required": [
            "object_version",
            "checksum_sha256",
            "media_type",
            "purpose_code"
          ],
          "type": "object"
        },
        "state_after": {
          "enum": [
            "evidence_under_review"
          ]
        },
        "state_before": {
          "enum": [
            "cap_accepted",
            "evidence_required",
            "evidence_rejected"
          ]
        }
      },
      "type": "object"
    }
  ],
  "title": "evidence_reference.submitted v1"
}
