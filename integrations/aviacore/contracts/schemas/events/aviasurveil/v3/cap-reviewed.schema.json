{
  "$id": "https://aviacore360.local/schemas/events/aviasurveil/v3/cap-reviewed.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "properties": {
        "entity_refs": {
          "additionalProperties": false,
          "properties": {
            "audit_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "cap_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "finding_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "audit_id",
            "finding_id",
            "cap_id"
          ],
          "type": "object"
        },
        "event_type": {
          "const": "cap.reviewed"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "decision_code": {
              "enum": [
                "accepted",
                "rejected",
                "more_information_required"
              ]
            },
            "reviewed_at": {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            }
          },
          "required": [
            "decision_code",
            "reviewed_at"
          ],
          "type": "object"
        },
        "state_after": {
          "enum": [
            "cap_accepted",
            "cap_rejected",
            "evidence_required"
          ]
        },
        "state_before": {
          "enum": [
            "cap_under_review"
          ]
        }
      },
      "type": "object"
    }
  ],
  "title": "cap.reviewed v1"
}
