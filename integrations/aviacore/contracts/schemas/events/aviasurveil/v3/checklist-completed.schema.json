{
  "$id": "https://aviacore360.local/schemas/events/aviasurveil/v3/checklist-completed.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "properties": {
        "entity_refs": {
          "additionalProperties": false,
          "properties": {
            "audit_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "checklist_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "audit_id",
            "checklist_id"
          ],
          "type": "object"
        },
        "event_type": {
          "const": "checklist.completed"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "checklist_ref": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "completed_at": {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            "nonconformity_count": {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "checklist_ref",
            "completed_at",
            "nonconformity_count"
          ],
          "type": "object"
        },
        "state_after": {
          "enum": [
            "checklist_completed"
          ]
        },
        "state_before": {
          "enum": [
            "audit_in_progress"
          ]
        }
      },
      "type": "object"
    }
  ],
  "title": "checklist.completed v1"
}
