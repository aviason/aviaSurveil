{
  "$id": "https://aviacore360.local/schemas/events/aviasurveil/v3/correction-recorded.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    },
    {
      "properties": {
        "entity_refs": {
          "additionalProperties": false,
          "properties": {
            "audit_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "audit_id"
          ],
          "type": "object"
        },
        "event_type": {
          "const": "correction.recorded"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "corrected_event_id": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "correction_reason_code": {
              "maxLength": 64,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            }
          },
          "required": [
            "corrected_event_id",
            "correction_reason_code"
          ],
          "type": "object"
        },
        "state_after": {
          "maxLength": 64,
          "type": "string"
        },
        "state_before": {
          "maxLength": 64,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  ],
  "title": "correction.recorded v1"
}
