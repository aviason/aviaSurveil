#!/bin/sh
set -eu

read_secret() {
  value=$(tr -d '\r\n' <"$1")
  if [ -z "$value" ]; then
    echo "required pgBackRest secret is empty" >&2
    exit 1
  fi
  printf '%s' "$value"
}

export PGBACKREST_REPO1_S3_KEY="$(
  read_secret /run/secrets/backup_pgbackrest_access_key
)"
export PGBACKREST_REPO1_S3_KEY_SECRET="$(
  read_secret /run/secrets/backup_pgbackrest_secret_key
)"
export PGBACKREST_REPO1_CIPHER_PASS="$(
  read_secret /run/secrets/backup_repository_cipher_passphrase
)"

exec pgbackrest "$@"
