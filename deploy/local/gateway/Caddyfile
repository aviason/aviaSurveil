{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

import /etc/caddy/security-headers.caddy

https://localhost:8443 {
	tls internal
	encode zstd gzip
	import security_headers

	@test_routes path /__test /__test/*
	handle @test_routes {
		respond 404
	}

	handle /otel/* {
		uri strip_prefix /otel
		reverse_proxy otel-collector:4318
	}

	handle /operations/* {
		reverse_proxy grafana:3000
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up traceparent {http.request.header.traceparent}
			header_up tracestate {http.request.header.tracestate}
			header_up X-Correlation-ID {http.request.header.X-Correlation-ID}
		}
	}

	handle /auth/* {
		reverse_proxy api:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
		}
	}

	handle /health/* {
		reverse_proxy api:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
		}
	}

	handle_path /identity/* {
		reverse_proxy auth:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
		}
	}

	@private_objects path /evidence-quarantine/* /evidence-clean/* /inspection-attachments/* /generated-documents/*
	handle @private_objects {
		reverse_proxy minio:9000
	}

	handle {
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy web:8080
	}
}
