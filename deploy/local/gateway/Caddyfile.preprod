{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

import /etc/caddy/security-headers.caddy

https://localhost:8445 {
	tls internal
	encode zstd gzip
	import security_headers

	@test_routes path /__test /__test/*
	handle @test_routes {
		respond 404
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy preprod-api:8080 {
			header_up traceparent {http.request.header.traceparent}
			header_up tracestate {http.request.header.tracestate}
			header_up X-Correlation-ID {http.request.header.X-Correlation-ID}
		}
	}

	handle /auth/* {
		reverse_proxy preprod-api:8080
	}

	handle /health/* {
		reverse_proxy preprod-api:8080
	}

	handle_path /identity/* {
		reverse_proxy preprod-auth:8080
	}

	@private_objects path /evidence-quarantine/* /evidence-clean/* /inspection-attachments/* /generated-documents/*
	handle @private_objects {
		reverse_proxy preprod-minio:9000
	}

	handle {
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy preprod-web-http:8080
	}
}
