{
  "schemaVersion": 2,
  "browserPublishedPorts": {
    "gateway": [{ "hostIp": "127.0.0.1", "published": 8443, "target": 8443 }]
  },
  "developerPublishedPorts": {
    "mailpit-tools": [
      { "hostIp": "127.0.0.1", "published": 1025, "target": 1025 },
      { "hostIp": "127.0.0.1", "published": 8025, "target": 8025 }
    ]
  },
  "externalImageServices": [
    "postgres",
    "minio-volume-init",
    "minio",
    "mailpit-volume-init",
    "mailpit",
    "mailpit-tools"
  ],
  "healthcheckRequiredServices": [
    "gateway",
    "web-demo",
    "web-http",
    "api",
    "worker",
    "postgres",
    "auth",
    "minio",
    "mailpit",
    "mailpit-tools"
  ],
  "profileServices": {
    "demo": ["web-demo"],
    "full": [
      "gateway",
      "web-http",
      "api",
      "worker",
      "migration",
      "postgres",
      "runtime-database-bootstrap",
      "runtime-database-permissions",
      "auth",
      "curated-foundation-loader",
      "prepared-roster-loader",
      "approved-aga-catalog-loader",
      "prior-audit-history-loader",
      "minio",
      "minio-volume-init",
      "mailpit",
      "mailpit-volume-init"
    ],
    "test": [
      "postgres",
      "runtime-database-bootstrap",
      "runtime-database-permissions",
      "migration",
      "auth",
      "curated-foundation-loader",
      "prepared-roster-loader",
      "approved-aga-catalog-loader",
      "prior-audit-history-loader",
      "minio",
      "minio-volume-init"
    ],
    "recovery": [
      "postgres",
      "runtime-database-bootstrap",
      "runtime-database-permissions",
      "migration",
      "auth",
      "curated-foundation-loader",
      "prepared-roster-loader",
      "approved-aga-catalog-loader",
      "prior-audit-history-loader",
      "minio",
      "minio-volume-init"
    ],
    "tools": ["mailpit-volume-init", "mailpit-tools"]
  },
  "publicNetworkServices": ["gateway"],
  "egressNetworkServices": { "mailpit-tools": ["tools"] },
  "rootUserExceptions": {
    "minio-volume-init": "A networkless one-shot container chowns only the task-scoped object-store volume before MinIO starts.",
    "mailpit-volume-init": "A networkless one-shot container chowns only the task-scoped Mailpit data volume before Mailpit starts."
  },
  "secretMounts": {
    "runtime-database-bootstrap": [
      "rds_master_database_url",
      "surveil_runtime_database_password",
      "surveil_migration_database_password",
      "surveil_bootstrap_database_password",
      "auth_runtime_database_password"
    ],
    "runtime-database-permissions": [
      "rds_master_database_url",
      "surveil_migration_database_password"
    ],
    "migration": ["surveil_migration_database_password"],
    "auth": [
      "auth_database_url",
      "auth_signing_key",
      "auth_data_encryption_key",
      "auth_mfa_key",
      "oidc_client_secret",
      "auth_admin_secret",
      "auth_bootstrap_secret"
    ],
    "curated-foundation-loader": ["surveil_bootstrap_database_url"],
    "prepared-roster-loader": ["surveil_bootstrap_database_url", "auth_bootstrap_secret"],
    "approved-aga-catalog-loader": ["surveil_bootstrap_database_url"],
    "prior-audit-history-loader": ["surveil_bootstrap_database_url"],
    "api": [
      "surveil_runtime_database_password",
      "auth_admin_secret",
      "minio_api_access_key",
      "minio_api_secret_key",
      "oidc_client_secret",
      "session_encryption_key",
      "smtp_password"
    ],
    "worker": [
      "surveil_runtime_database_password",
      "auth_admin_secret",
      "minio_worker_access_key",
      "minio_worker_secret_key",
      "oidc_client_secret",
      "session_encryption_key",
      "smtp_password"
    ],
    "postgres": ["rds_master_database_password"],
    "minio": [
      "minio_api_access_key",
      "minio_api_secret_key",
      "minio_root_password",
      "minio_root_user",
      "minio_worker_access_key",
      "minio_worker_secret_key"
    ],
    "mailpit": ["smtp_auth_file"],
    "mailpit-tools": ["smtp_auth_file"]
  },
  "writableRootfsExceptions": {}
}
