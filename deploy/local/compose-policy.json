  "rootUserExceptions": {
    "clamav": "The reviewed upstream image starts its supervisor with CHOWN/DAC_OVERRIDE/SETGID/SETUID so freshclam can initialize the signature volume, then its daemons drop to the clamav account.",
    "minio-volume-init": "A networkless one-shot container chowns only the task-scoped MinIO data volume before the non-root MinIO service starts.",
    "mailpit-volume-init": "A networkless one-shot container chowns only the task-scoped Mailpit data volume before the non-root Mailpit service starts."
  },
