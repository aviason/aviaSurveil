{
  "schemaVersion": 1,
  "browserPublishedPorts": {
    "gateway": [
      { "hostIp": "127.0.0.1", "published": 8443, "target": 8443 }
    ]
  },
  "developerPublishedPorts": {
    "mailpit-tools": [
      { "hostIp": "127.0.0.1", "published": 1025, "target": 1025 },
      { "hostIp": "127.0.0.1", "published": 8025, "target": 8025 }
    ]
  },
  "databaseIsolation": {
    "applicationService": "postgres",
    "identityService": "preprod-auth-postgres",
    "dataTarget": "/var/lib/postgresql/data"
  },
  "externalImageServices": [
    "postgres",
    "preprod-auth-postgres",
    "minio",
    "minio-volume-init",
    "mailpit",
    "mailpit-volume-init",
    "mailpit-tools"
  ],
  "healthcheckRequiredServices": [
    "gateway",
    "web-demo",
    "web-http",
    "api",
    "worker",
    "postgres",
    "preprod-auth-postgres",
    "preprod-auth",
    "minio",
    "mailpit",
    "mailpit-tools"
  ],
  "profileServices": {
    "demo": [
      "gateway",
      "web-demo",
      "preprod-auth-postgres",
      "preprod-auth"
    ],
    "full": [
      "gateway",
      "web-http",
      "api",
      "worker",
      "migration",
      "postgres",
      "preprod-auth-postgres",
      "preprod-auth",
      "minio",
      "minio-volume-init",
      "mailpit",
      "mailpit-volume-init"
    ],
    "test": ["fixture-init", "postgres", "minio", "minio-volume-init"],
    "recovery": ["postgres", "minio", "minio-volume-init"],
    "tools": ["mailpit-volume-init", "mailpit-tools"]
  },
  "publicNetworkServices": ["gateway"],
  "egressNetworkServices": {
    "mailpit-tools": ["tools"]
  },
  "rootUserExceptions": {
    "minio-volume-init": "A networkless one-shot container chowns only the task-scoped MinIO data volume before the non-root MinIO service starts.",
    "mailpit-volume-init": "A networkless one-shot container chowns only the task-scoped Mailpit data volume before the non-root Mailpit service starts."
  },
  "secretMounts": {
    "api": [
      "app_database_password",
      "preprod_auth_admin_secret",
      "minio_api_access_key",
      "minio_api_secret_key",
      "preprod_oidc_client_secret",
      "session_encryption_key"
    ],
    "worker": [
      "app_database_password",
      "preprod_auth_admin_secret",
      "minio_worker_access_key",
      "minio_worker_secret_key",
      "preprod_oidc_client_secret",
      "session_encryption_key",
      "smtp_password"
    ],
    "migration": ["app_database_password"],
    "fixture-init": ["app_database_password"],
    "postgres": ["app_database_password"],
    "preprod-auth-postgres": ["preprod_auth_database_password"],
    "preprod-auth": [
      "preprod_auth_database_url",
      "preprod_auth_signing_key",
      "preprod_auth_data_encryption_key",
      "preprod_auth_mfa_key",
      "preprod_oidc_client_secret",
      "preprod_auth_admin_secret"
    ],
    "minio": [
      "minio_api_access_key",
      "minio_api_secret_key",
      "minio_root_password",
      "minio_root_user",
      "minio_worker_access_key",
      "minio_worker_secret_key"
    ],
    "mailpit": ["smtp_auth_file"],
    "mailpit-tools": ["smtp_auth_file"]
  },
  "writableRootfsExceptions": {}
}
