{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviasurveil360.invalid/schemas/aws-private-pilot-release-manifest.schema.json",
  "title": "AviaSurveil360 AWS private-pilot release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "issuedAt",
    "expiresAt",
    "artifactStatus",
    "releasePending",
    "productionReady",
    "architecture",
    "sourceTreeSha256",
    "subjects",
    "bindings",
    "database",
    "rollback",
    "targets",
    "authorization"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,80}$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "artifactStatus": { "const": "candidate-only" },
    "releasePending": { "const": true },
    "productionReady": { "const": false },
    "architecture": { "const": "linux/arm64" },
    "sourceTreeSha256": { "$ref": "#/$defs/digest" },
    "subjects": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": { "$ref": "#/$defs/subject" }
    },
    "bindings": {
      "type": "object",
      "minProperties": 19,
      "additionalProperties": { "$ref": "#/$defs/binding" }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latestMigrationVersion", "forwardOnly", "runtimeRole", "migrationRole", "migrationRoleLockedAfterUse"],
      "properties": {
        "latestMigrationVersion": { "type": "integer", "minimum": 1 },
        "forwardOnly": { "const": true },
        "runtimeRole": { "const": "aviasurveil360_runtime" },
        "migrationRole": { "const": "aviasurveil360_migrator" },
        "migrationRoleLockedAfterUse": { "const": true }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessorManifestSha256", "nMinusOneCompatible", "compatibilityEvidenceSha256", "incompatibleAction"],
      "properties": {
        "predecessorManifestSha256": { "$ref": "#/$defs/digest" },
        "nMinusOneCompatible": { "type": "boolean" },
        "compatibilityEvidenceSha256": { "$ref": "#/$defs/digest" },
        "incompatibleAction": { "const": "roll-forward-or-coordinated-restore" }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["awsProfile", "awsAccountId", "region", "hostname", "instanceId", "databaseArn", "bucketArns", "cloudflareAccountId", "cloudflareZoneId", "cloudflareTunnelId", "connectorParameterArn", "terraformAddresses", "retainOrDestroyDecision"],
      "properties": {
        "awsProfile": { "const": "avia" },
        "awsAccountId": { "type": "string", "pattern": "^[0-9]{12}$" },
        "region": { "type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$" },
        "hostname": { "type": "string", "minLength": 4 },
        "instanceId": { "type": "string", "pattern": "^i-[0-9a-f]{17}$" },
        "databaseArn": { "type": "string", "pattern": "^arn:aws[^:]*:rds:" },
        "bucketArns": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^arn:aws[^:]*:s3:::" }
        },
        "cloudflareAccountId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "cloudflareZoneId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "cloudflareTunnelId": { "type": "string", "format": "uuid" },
        "connectorParameterArn": { "type": "string", "pattern": "^arn:aws[^:]*:ssm:" },
        "terraformAddresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+(?:\\[[^]]+\\])?$" }
        },
        "retainOrDestroyDecision": { "enum": ["retain", "destroy-pending-separate-authorization"] }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "remoteActionsAuthorized", "productionReleaseAuthorized"],
      "properties": {
        "scope": { "const": "local-preparation-only" },
        "remoteActionsAuthorized": { "const": false },
        "productionReleaseAuthorized": { "const": false }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "platform", "configDigest", "sbomSha256", "provenanceSha256", "vulnerabilityEvidenceSha256"],
      "properties": {
        "image": { "type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$" },
        "platform": { "const": "linux/arm64" },
        "configDigest": { "$ref": "#/$defs/digest" },
        "sbomSha256": { "$ref": "#/$defs/digest" },
        "provenanceSha256": { "$ref": "#/$defs/digest" },
        "vulnerabilityEvidenceSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
