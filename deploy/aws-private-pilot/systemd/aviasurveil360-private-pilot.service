[Unit]
Description=AviaSurveil360 AWS private-pilot Docker Compose runtime
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=aviasurveil360-private-pilot
RuntimeDirectoryMode=0700
EnvironmentFile=/etc/aviasurveil360/private-pilot/runtime.env
Environment=DOCKER_CONFIG=/etc/aviasurveil360/private-pilot/docker
Environment=AWS_ECR_DISABLE_CACHE=true
Environment=AWS_USE_DUALSTACK_ENDPOINT=true
WorkingDirectory=/opt/aviasurveil360/private-pilot
ExecStartPre=/opt/aviasurveil360/private-pilot/deploy/aws-private-pilot/runtime/supervisor.sh validate-runtime
ExecStartPre=/opt/aviasurveil360/private-pilot/deploy/aws-private-pilot/runtime/ipv6-preflight.sh runtime
ExecStart=/usr/bin/docker compose --project-name aviasurveil360-private-pilot --file deploy/aws-private-pilot/compose.yaml up --detach --remove-orphans --wait gateway api worker keycloak
ExecStartPost=/opt/aviasurveil360/private-pilot/deploy/aws-private-pilot/runtime/supervisor.sh health
ExecStop=/opt/aviasurveil360/private-pilot/deploy/aws-private-pilot/runtime/supervisor.sh drain
ExecStop=/usr/bin/docker compose --project-name aviasurveil360-private-pilot --file deploy/aws-private-pilot/compose.yaml stop --timeout 45
TimeoutStartSec=300
TimeoutStopSec=120
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/aviasurveil360/private-pilot /etc/aviasurveil360/private-pilot
ReadWritePaths=/run/aviasurveil360-private-pilot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
